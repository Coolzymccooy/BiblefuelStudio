# Required: MiniMax API key. MiniMax M2.7 is currently free on opencode.
# Sign up at https://platform.minimax.io/ → create a Token Plan API key.
MINIMAX_API_KEY=

# Required for any non-localhost deployment. Pick a long random string.
# biblefuel-studio's server/.env must use the SAME password as OPENCODE_SERVER_PASSWORD.
OPENCODE_SERVER_PASSWORD=

# Optional: defaults to "opencode" if unset
OPENCODE_SERVER_USERNAME=opencode
