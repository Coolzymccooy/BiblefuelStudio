PORT=5051
CORS_ORIGIN=http://localhost:5051

# Script generation (optional)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# OpenCode self-hosted server — PARKED, gated behind a feature flag.
# Deployment kit lives at deploy/opencode/ but the integration is dormant
# until OPENCODE_ENABLED=true. Flip the flag only after picking a real free
# provider (OpenRouter free models or OpenCode Zen) — MiniMax's direct API
# is paid, contrary to what the opencode CLI experience suggests.
# See deploy/opencode/README.md for activation steps when ready.
# OPENCODE_ENABLED=false
# OPENCODE_BASE_URL=http://localhost:4096
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_MODEL=
# OPENCODE_AGENT=
# OPENCODE_POLL_MS=1500
# OPENCODE_MAX_WAIT_MS=60000

# Pexels (optional)
# PEXELS_API_KEY=

# ElevenLabs TTS (optional — premium provider for narration + voice cloning)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Edge-TTS (free Microsoft "Read Aloud" service — ~400 neural voices, no key)
# Unofficial wrapper around the Edge browser's Read Aloud endpoint, powered by
# the `msedge-tts` npm package. Quality is comparable to ElevenLabs standard.
# Flip ENABLED=false to disable if Microsoft tightens the anti-bot scheme.
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=en-US-AriaNeural

# Chatterbox local HTTP bridge (optional — open-source Resemble AI model).
# Run tools/chatterbox-server/ alongside this server and point CHATTERBOX_URL
# at it. Off by default. CPU inference is slow (~50s per 2s of audio); set the
# timeout generously. Used by the chatterbox provider in voice/.
# CHATTERBOX_URL=http://127.0.0.1:8000
# CHATTERBOX_TIMEOUT_MS=600000
# CHATTERBOX_AUDIO_PROMPT=          # optional reference voice WAV (absolute path on the chatterbox server)

# FFmpeg (optional)
# Rendering Optimization
FFMPEG_PATH=ffmpeg
FFMPEG_HWACCEL=      # Set to 'nvenc' (Nvidia) or 'qsv' (Intel) for hardware acceleration
FFMPEG_PRESET=fast   # FFmpeg preset (ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow)
FFPROBE_PATH=

OUTPUT_DIR=./outputs

# Remote internet access
ADMIN_SETUP_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
DATA_DIR=./data

# Firebase Admin (optional: required for Firebase auth verification and storage mirroring)
# Create a service account in Firebase Console > Project settings > Service accounts
# and copy values into these env vars.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MIRROR_OUTPUTS=false

# YouTube Direct Posting (optional: used as fallback when social.json is empty)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Jobs reliability tuning (optional)
# JOB_EXEC_TIMEOUT_SEC=600
# STALE_RUNNING_JOB_MINUTES=45

# Bible verse lookup (optional)
# Required ONLY for copyrighted translations (NIV, NKJV, NLT) via api.bible.
# Get a free developer key at https://scripture.api.bible.
# Without this, public-domain translations (KJV, WEB, ASV, BBE, YLT) still
# work via bible-api.com — no setup needed.
# SCRIPTURE_API_BIBLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Generative artwork for Series Mode (£0 stack, opt-in per series).
# ─────────────────────────────────────────────────────────────────────────
# Default off. Turn on per-series via the "Add AI-generated artwork" toggle
# on the Series page. Failover order is:
#   1. Cloudflare Workers AI — FLUX-1-schnell, 10,000 neurons/day free FOREVER
#      (≈ 200–300 1024×1024 images/day). Commercial use explicitly permitted.
#      Token: create at https://dash.cloudflare.com → AI → Workers AI → API tokens
#      (Workers AI Read scope is enough).
#   2. Google Imagen via Gemini API — REQUIRES A PAID Google AI Studio plan
#      as of mid-2026 (free tier image-gen quota is 0). Commercial use
#      permitted; invisible SynthID watermark only. Use only if you have
#      billing enabled at https://aistudio.google.com/apikey
#
# Provider rotation: leave IMAGE_GEN_PROVIDER unset (or set to "auto") to try
# Cloudflare first, then Imagen. Set to "cloudflare" or "imagen" to force one,
# or "none" to disable image gen entirely without removing the credentials.
#
# IMAGE_GEN_ENABLED=true              # force-enable; defaults true if either provider configured
# IMAGE_GEN_PROVIDER=auto             # auto | cloudflare | imagen | none
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# GOOGLE_GEMINI_API_KEY=              # OR re-use GEMINI_API_KEY from script-gen above
# IMAGEN_MODEL=imagen-4.0-fast-generate-001
