PORT=5051
CORS_ORIGIN=http://localhost:5051

# Script generation (optional)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# OpenCode self-hosted server — PARKED, gated behind a feature flag.
# Deployment kit lives at deploy/opencode/ but the integration is dormant
# until OPENCODE_ENABLED=true. Flip the flag only after picking a real free
# provider (OpenRouter free models or OpenCode Zen) — MiniMax's direct API
# is paid, contrary to what the opencode CLI experience suggests.
# See deploy/opencode/README.md for activation steps when ready.
# OPENCODE_ENABLED=false
# OPENCODE_BASE_URL=http://localhost:4096
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_MODEL=
# OPENCODE_AGENT=
# OPENCODE_POLL_MS=1500
# OPENCODE_MAX_WAIT_MS=60000

# Pexels (optional)
# PEXELS_API_KEY=

# ElevenLabs TTS (optional — premium provider for narration + voice cloning)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Fish Audio TTS (optional — premium cloud alternative to ElevenLabs).
# Expressive, multilingual, supports voice cloning via reference models.
# Gated to premium/super_admin plans (it costs credits). Voice is selected by
# reference_id (a Fish voice-model id), not a free-form name. See
# docs/FISH_AUDIO_SETUP.md.
# FISH_API_KEY=
# FISH_API_BASE_URL=https://api.fish.audio
# FISH_DEFAULT_MODEL=s1
# FISH_DEFAULT_REFERENCE_ID=          # optional fallback voice-model id
# FISH_TIMEOUT_MS=60000

# Azure Speech (primary kinetic-caption / word-timestamp provider).
# Emits native WordBoundary timings → normalized word-alignment contract for
# kinetic typography. Commercial-safe; generous free tier. The orchestrator
# auto-routes timestamp renders here (word-level beats char-level). Requires
# the `microsoft-cognitiveservices-speech-sdk` dependency. See
# docs/AZURE_SPEECH_SETUP.md.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_VOICE=en-US-GuyNeural
# AZURE_SPEECH_OUTPUT_FORMAT=Audio24Khz48KBitRateMonoMp3
# AZURE_SPEECH_TIMEOUT_MS=60000

# Edge-TTS (free Microsoft "Read Aloud" service — ~400 neural voices, no key)
# Unofficial wrapper around the Edge browser's Read Aloud endpoint, powered by
# the `msedge-tts` npm package. Quality is comparable to ElevenLabs standard.
# Flip ENABLED=false to disable if Microsoft tightens the anti-bot scheme.
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=en-US-AriaNeural

# Chatterbox local HTTP bridge (optional — open-source Resemble AI model).
# Run tools/chatterbox-server/ alongside this server and point CHATTERBOX_URL
# at it. Off by default. CPU inference is slow (~50s per 2s of audio); set the
# timeout generously. Used by the chatterbox provider in voice/.
# CHATTERBOX_URL=http://127.0.0.1:8000
# CHATTERBOX_TIMEOUT_MS=600000
# CHATTERBOX_AUDIO_PROMPT=          # optional reference voice WAV (absolute path on the chatterbox server)

# Vocal removal ("Make instrumental" in the music library, optional — laptop only).
# Points at the audio-separator CLI in its own Python venv. Unset (as on the
# deployed server) hides the feature entirely. See docs/vocal-removal.md for
# setup steps and the ModuleNotFoundError: audioread gotcha.
# STEMS_CLI=C:\path\to\stems-venv\Scripts\audio-separator.exe
# STEMS_MODEL_DIR=C:\path\to\stems-models   # optional — where downloaded models are cached

# Song mode: time lyrics from the song's separated vocals (laptop worker; needs STEMS_WORKER_TOKEN).
# Off by default: it has not beaten timing from the mix yet. Set to 1 to opt in.
# LYRIC_VOCALS=1

# Piper local HTTP bridge (optional — rhasspy/piper, fast neural CPU TTS).
# Free local fallback in the priority chain (slot 4). Set PIPER_URL to your
# Piper HTTP wrapper's endpoint; see docs/PIPER_SETUP.md for the contract
# and a reference Python wrapper. Bare TTS — no native timestamps; caption
# sync falls back to forced-alignment when withTimestamps is requested.
# PIPER_URL=http://127.0.0.1:5050/tts
# PIPER_VOICE=en_US-amy-low
# PIPER_TIMEOUT_MS=30000

# FFmpeg (optional)
# Rendering Optimization
FFMPEG_PATH=ffmpeg
FFMPEG_HWACCEL=      # Set to 'nvenc' (Nvidia) or 'qsv' (Intel) for hardware acceleration
FFMPEG_PRESET=fast   # FFmpeg preset (ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow)
FFPROBE_PATH=

# Story render dimensions (optional)
STORY_RENDER_LANDSCAPE_WIDTH=1280    # Landscape aspect (16:9) width
STORY_RENDER_LANDSCAPE_HEIGHT=720    # Landscape aspect (16:9) height

OUTPUT_DIR=./outputs

# Remote internet access
ADMIN_SETUP_KEY=
# Required in production: a long random value (32+ characters). The server will not start without one.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
DATA_DIR=./data

# Firebase Admin (optional: required for Firebase auth verification and storage mirroring)
# Create a service account in Firebase Console > Project settings > Service accounts
# and copy values into these env vars.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MIRROR_OUTPUTS=false

# YouTube Direct Posting (optional: used as fallback when social.json is empty)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Jobs reliability tuning (optional)
# JOB_EXEC_TIMEOUT_SEC=600
# STALE_RUNNING_JOB_MINUTES=45

# Bible verse lookup (optional)
# Required ONLY for copyrighted translations (NIV, NKJV, NLT) via api.bible.
# Get a free developer key at https://scripture.api.bible.
# Without this, public-domain translations (KJV, WEB, ASV, BBE, YLT) still
# work via bible-api.com — no setup needed.
# SCRIPTURE_API_BIBLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Generative artwork for Series Mode (£0 stack, opt-in per series).
# ─────────────────────────────────────────────────────────────────────────
# Default off. Turn on per-series via the "Add AI-generated artwork" toggle
# on the Series page. Failover order is:
#   1. Cloudflare Workers AI — FLUX-1-schnell, 10,000 neurons/day free FOREVER
#      (≈ 200–300 1024×1024 images/day). Commercial use explicitly permitted.
#      Token: create at https://dash.cloudflare.com → AI → Workers AI → API tokens
#      (Workers AI Read scope is enough).
#   2. Google Imagen via Gemini API — REQUIRES A PAID Google AI Studio plan
#      as of mid-2026 (free tier image-gen quota is 0). Commercial use
#      permitted; invisible SynthID watermark only. Use only if you have
#      billing enabled at https://aistudio.google.com/apikey
#
# Provider rotation: leave IMAGE_GEN_PROVIDER unset (or set to "auto") to try
# Cloudflare first, then Imagen. Set to "cloudflare" or "imagen" to force one,
# or "none" to disable image gen entirely without removing the credentials.
#
# IMAGE_GEN_ENABLED=true              # force-enable; defaults true if either provider configured
# IMAGE_GEN_PROVIDER=auto             # auto | cloudflare | together | pollinations | imagen | none

# Together AI — free FLUX.1-schnell endpoint, tried when the Cloudflare daily
# image quota is spent. Quality sits below Lucid Origin, so it is a fallback.
# TOGETHER_API_KEY=
# TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# Image reuse: a Story scene reuses a library image at or above this cosine
# score instead of generating a new one (needs OPENAI_API_KEY for embeddings;
# falls back to keyword categories without it).
# IMAGE_REUSE_ENABLED=true
# IMAGE_REUSE_THRESHOLD=0.82
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/leonardo/lucid-origin   # default; native 16:9 / 9:16. flux-1-schnell = near-free square
# GOOGLE_GEMINI_API_KEY=              # OR re-use GEMINI_API_KEY from script-gen above
# IMAGEN_MODEL=imagen-4.0-fast-generate-001

# --- Email (Resend) ----------------------------------------------------------
# Used by the public Request-Access form on the landing page.
# When RESEND_API_KEY is empty, the transport runs in stub mode and only logs.
RESEND_API_KEY=
MAIL_FROM=Biblefuel <hello@tiwaton.co.uk>
MAIL_REPLY_TO=
# Where access-request notification emails are delivered:
ACCESS_REQUEST_NOTIFY_TO=

# ─── Phase 1 public multi-tenancy ─────────────────────────────────────────
# See docs/superpowers/specs/2026-05-26-public-multitenancy-design.md.
#
# MULTI-TENANT IS ON BY DEFAULT (when this var is unset or "true"): per-user
# data lives under DATA_DIR/users/<userId>/. Exactly ONE super-admin, the
# OWNER, keeps reading/writing the legacy global files (so the operator's
# existing library/jobs aren't orphaned), sees every job, and may post
# through the env Zernio TikTok account. Every other super-admin keeps admin
# rights but gets their own DATA_DIR/users/<userId>/ like any user.
#
# The owner is chosen in this order:
#   1. SUPER_ADMIN_USER_ID, when set
#   2. otherwise the first email in OWNER_EMAIL, when set
#   3. otherwise the FIRST email in SUPER_ADMIN_EMAIL
# With several admin emails and no OWNER_EMAIL, LIST ORDER decides who owns
# the operator's workspace: reordering SUPER_ADMIN_EMAIL would hand it, and
# the Zernio TikTok, to another admin. Set OWNER_EMAIL to pin it. The server
# logs a warning at startup when ownership rests on list order.
#
# ALWAYS set SUPER_ADMIN_EMAIL to the operator's account before the first
# multi-tenant boot, or the operator will land as a regular user with no
# access to the legacy data.
#
# Set MULTITENANT=false only on operator-only single-tenant deployments.
# In that mode every signed-in user shares the global data dir — NEVER do
# this on a public deploy (every new user will see every other user's jobs).
# MULTITENANT=true
SUPER_ADMIN_EMAIL=
# OWNER_EMAIL=  # recommended with several admins: the one admin email that owns the main workspace (must also be in SUPER_ADMIN_EMAIL)
# SUPER_ADMIN_USER_ID=  # optional: a user id that is an admin AND the owner, overriding OWNER_EMAIL and list order

# ─── Phase 3: Stripe billing ──────────────────────────────────────────────
# Without these set, /api/billing/* returns 503 PAYMENTS_NOT_CONFIGURED and
# the upgrade button hides in the UI. Webhook secret comes from the Stripe
# dashboard once you point the endpoint at https://<your-domain>/api/billing/webhook
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# REQUIRE_EMAIL_VERIFIED=true   # uncomment to enforce on expensive routes

# ─── Phase 4: Postiz auto-publish bridge ──────────────────────────────────
# Self-hosted Postiz instance (https://github.com/gitroomhq/postiz-app).
# Without these set, /api/postiz/* returns 503 POSTIZ_NOT_CONFIGURED and the
# "Connect platform" buttons hide in the UI.
# POSTIZ_URL=https://postiz.tiwaton.co.uk
# POSTIZ_API_KEY=

# AI scenes (BytePlus ModelArk Seedance) — super admins only
BYTEPLUS_ARK_API_KEY=
# BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Monthly spend cap in US$ across every super admin (default 30)
# VIDEO_GEN_MONTHLY_CAP_USD=30
# Fraction of list price actually charged, e.g. 0.4 during a promotion (default 1)
# VIDEO_GEN_PRICE_MULTIPLIER=1
# Veo (Timeline B-roll) is for super admins only and shares the cap above.
# Veo reports no cost, so each clip is charged at seconds x this rate (default 0.75).
# VEO_USD_PER_SECOND=0.75

# --- TikTok through Zernio (zernio.com) ---------------------------------------
# One Zernio API key for the whole server. The owner posts to the TikTok in
# ZERNIO_TIKTOK_ACCOUNT_ID. Other admins click "Connect TikTok" in Settings:
# each gets their own Zernio profile and posts only to the TikTok they
# connected. Zernio bills per connected account (first 2 free, then from
# $6/month each), so connecting is limited to admins. Any user can instead
# paste an API key from their OWN Zernio account; that is billed to them, and
# works even when ZERNIO_API_KEY is not set.
# ZERNIO_API_KEY=
# ZERNIO_TIKTOK_ACCOUNT_ID=

# --- Agent access (MCP, /api/mcp) ---------------------------------------------
# Host names /api/mcp answers on (comma-separated). Unset: localhost, 127.0.0.1,
# [::1], biblefuel.tiwaton.co.uk and every host in CORS_ORIGIN. When set, it
# REPLACES that list, so include every host agents will call.
# MCP_ALLOWED_HOSTS=biblefuel.tiwaton.co.uk
# The site's public origin. MCP tools build media links (webhook posts, output
# urls) from it instead of the request's Host header; the production site's
# links then point at its media host. Unset: the request's own host.
# PUBLIC_BASE_URL=https://biblefuel.tiwaton.co.uk
# Daily ceilings per agent key (midnight UTC reset; apply to every plan,
# super admins included). A key can be set lower in Settings, never higher.
# MCP_DAILY_RENDERS=10
# MCP_DAILY_AI_VIDEO_USD=2
# MCP_DAILY_IMAGES=30
# MCP_DAILY_TTS=30
# MCP_DAILY_PUBLISHES=3
# MCP_DAILY_IMPORTS=20
# Overall deadline for one media_import_url download, in ms (default 10 minutes).
# IMPORT_URL_TIMEOUT_MS=600000
# Largest input file in MB for renders; it also caps media_import_url downloads.
# MAX_INPUT_MB=200

# --- Alerts, error tracking, housekeeping and backups ---------------------------
# Alerts (render failures, low disk, failed backups) are emailed through Resend,
# at most once an hour per kind, to OPS_ALERT_EMAIL, else the owner.
# OPS_ALERT_EMAIL=
# Sentry error tracking is on when this is set (errors only, no personal data).
# SENTRY_DSN=
# Low-disk alarm: under this many GB or this % free, whichever is larger (defaults 2 and 10)
# DISK_ALARM_MIN_FREE_GB=2
# DISK_ALARM_MIN_FREE_PERCENT=10
# Throwaway files (render debug dumps, concat lists, waveform pictures, the
# remote background cache) are deleted after this many days (default 14).
# Finished videos, uploads and the visual library are never deleted.
# MEDIA_CLEANUP_MAX_AGE_DAYS=14
# Nightly backups to the Firebase storage bucket (backups/ in the bucket).
# On by default in production; set false to stop them, true to run them elsewhere.
# BACKUP_ENABLED=
# Back up to a local folder instead of the bucket, e.g. dir:/backups
# BACKUP_TARGET=
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP_DAYS=14
# Most output files copied in one night (default 5); the rest wait for the next night.
# BACKUP_OUTPUTS_MAX_GB=5
# Restore: node scripts/restore-backup.mjs --list | --data <empty dir> [--date YYYY-MM-DD] | --outputs <empty dir>
